# ==========================================
# Drivers Compliance System - Environment Config
# ==========================================

# Database: AWS RDS (PostgreSQL) or local SQLite fallback
# When using AWS RDS, ensure sslmode=require and schema search_path is set:
# DATABASE_URL="postgresql://postgres:<PASSWORD>@go-green.cu96gm0gk1vx.us-east-1.rds.amazonaws.com:5432/postgres?options=-c%20search_path=driver_compliance,public&sslmode=require"
# Local fallback (default if not set):
DATABASE_URL="sqlite:///./driver_compliance.db"

# Dedicated PostgreSQL Schema (to protect Go Green shared RDS tables)
DB_SCHEMA="driver_compliance"

# AWS S3 Storage Configuration
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="gogreen11"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Project Prefix: MUST be unique (CRITICAL: NEVER USE 'accident-claims')
AWS_S3_PROJECT_FOLDER="driver-compliance"

# If AWS S3 credentials are blank, files are stored locally in:
LOCAL_STORAGE_DIR="./uploads"

# Security & Authentication (Staff Only)
JWT_SECRET_KEY="drivers-compliance-super-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (seeded on first startup)
INITIAL_ADMIN_EMAIL="admin@company.com"
INITIAL_ADMIN_PASSWORD="admin123"
INITIAL_ADMIN_NAME="Company Compliance Admin"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
